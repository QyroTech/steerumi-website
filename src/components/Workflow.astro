---
import type { Project } from "../data/project";
import SectionHeading from "./SectionHeading.astro";
import ProjectFigure from "./ProjectFigure.astro";
import VideoGallery from "./VideoGallery.astro";
interface Props {
  workflow: Project["workflow"];
}
const { workflow } = Astro.props;
---

<section id="workflow" class="page-section workflow-section">
  <div class="section-shell">
    <SectionHeading
      label="02 / Automated Policy Iteration"
      title={workflow.title}
    />
    <VideoGallery id="workflow-videos" groups={workflow.videos} />
    <div class="after-video">
      <section class="workflow-subsection" aria-labelledby="round-steps-title">
        <h3 id="round-steps-title">What happens between rounds</h3>
        <ol class="round-steps" role="list">
          {
            workflow.steps.map((step, index) => (
              <li>
                <span class="round-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h4>{step.title}</h4>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>
      <section class="workflow-subsection" aria-labelledby="cloud-edge-title">
        <h3 id="cloud-edge-title">Cloud-Edge workflow</h3>
        <ProjectFigure figure={workflow.figure} showCaption={false} />
      </section>
    </div>
  </div>
</section>

<style>
  .workflow-section {
    padding-block: clamp(32px, 4.5vw, 68px) clamp(54px, 6vw, 88px);
  }
  .workflow-section :global(.section-heading h2) {
    max-width: 1000px;
  }
  .workflow-section :global(.video-group) {
    margin-top: 0;
  }
  .after-video {
    display: grid;
    gap: calc(15px + 0.75rem);
    margin-top: 30px;
  }
  .workflow-subsection {
    display: grid;
    gap: 14px;
  }
  .workflow-subsection :global(.research-figure) {
    margin: 0;
  }
  .workflow-section .round-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .round-steps li {
    border: 1px solid var(--page-line);
    border-radius: 10px;
    padding: 14px 16px;
    background: var(--page-soft);
  }
  .round-index {
    display: block;
    color: var(--page-accent);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    margin-bottom: 5px;
  }
  .round-steps h4 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.35;
  }
  .round-steps p {
    margin-top: 6px;
    color: var(--page-secondary);
    font-size: 0.87rem;
    line-height: 1.55;
  }
  @media (max-width: 850px) {
    .workflow-section .round-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 440px) {
    .workflow-section .round-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
