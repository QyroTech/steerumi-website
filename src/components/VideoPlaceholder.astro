---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="not-prose">
  <div class="mb-2 font-medium">{title}</div>
  <div
    data-video-placeholder
    class="flex aspect-video w-full items-center justify-center rounded-lg border border-dashed border-zinc-300 bg-zinc-100 text-zinc-500"
    role="img"
    aria-label={`${title}: video placeholder, video to be added`}
  >
    <span class="text-sm">Video to be added</span>
  </div>
</div>
