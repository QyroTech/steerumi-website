<dialog
  id="image-lightbox"
  class="image-lightbox"
  aria-label="Full-size research figure"
>
  <div class="lightbox-toolbar">
    <span>Full-size figure</span><button
      type="button"
      class="small-button secondary"
      data-close-lightbox
      aria-label="Close image viewer">Close ×</button
    >
  </div>
  <div class="lightbox-image-wrap"><img id="lightbox-image" alt="" /></div>
  <p id="lightbox-caption"></p>
</dialog>
